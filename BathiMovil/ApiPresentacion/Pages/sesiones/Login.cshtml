@page
@model LoginModel
@{
    ViewData["Title"] = "Home page";
}

    @if (Model.EstaRegistrandose)
    {
        <div class="popup">
            <div class="popup-dialog">
                <div class="popup-body">
                    <div class="popup-icon">👤</div>
                    <div>
                        <p class="popup-title">Registro</p>
                        <p class="popup-message">
                            Que tipo de <strong> cliente </strong> Eres?
                        </p>
                    </div>
                </div>
               <div style="display: flex; gap: 12px; justify-content: center;" class="popup-footer">
  <form method="POST">
    <input type="submit"
           value="Casual👤"
            asp-page-handler="BtSeguirCliente"
           class="btn btn-danger" />

    <input type="submit"
           value="Empresarial🏪"
           asp-page-handler="BtSeguirEmpresarial"
           class="btn btn-danger" />
                </form>
             </div>
        </div>
    </div>
    
                }


@if (Model.Siguiente)
{
    <form method="POST">
        @* ← El form envuelve TODO el contenido *@
        <div class="popup">
            <div class="popup-dialog">
                <div class="popup-body">
                    <div class="popup-icon">👤</div>
                    <div style="width: 100%;">
                        <p class="popup-title">Crear cuenta</p>

                        @if (Model.EsCliente == 1)
                        {
                            <input type="hidden" asp-for="@Model.Cliente!.Id_Persona" />
                            <div class="form-group">
                                <label>Nombre completo</label>
                                <input asp-for="@Model.Cliente!.Nombre" class="form-control" placeholder="Juan García" />
                                <span asp-validation-for="Cliente.Nombre" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label>Cedula</label>
                                <input asp-for="@Model.Cliente!.Cedula" class="form-control" placeholder="3448923892" />
                                <span asp-validation-for="Cliente.Cedula" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label>Correo electrónico</label>
                                <input asp-for="@Model.Cliente!.Correo" type="email" class="form-control" placeholder="Example@correo.com" />
                                <span asp-validation-for="Cliente.Correo" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label>Telefono</label>
                                <input asp-for="@Model.Cliente!.Telefono" class="form-control" placeholder="Telefono" />
                                <span asp-validation-for="Cliente.Telefono" class="text-danger"></span>
                            </div>
                        }

                        @if (Model.EsCliente == 2)
                        {
                            <div class="form-group">
                                <label>Codigo de empresa</label>
                                <input asp-for="@Model.Cliente!.Nit_CC" class="form-control" placeholder="Codigo de empresa" />
                                <span asp-validation-for="Cliente.Nit_CC" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label>Razon Social</label>
                                <input asp-for="@Model.Cliente!.Razon_Social" class="form-control" placeholder="Razon social" />
                                <span asp-validation-for="Cliente.Razon_Social" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label>Direccion Fiscal</label>
                                <input asp-for="@Model.Cliente!.Direccion_Fiscal" class="form-control" placeholder="Direccion fiscal" />
                                <span asp-validation-for="Cliente.Direccion_Fiscal" class="text-danger"></span>
                            </div>
                        }

                        <div class="form-group">
                            <label>Nombre de usuario</label>
                            <input asp-for="@Model.Usuario!.Username" class="form-control" placeholder="Mínimo 8 caracteres" />
                            <span asp-validation-for="Usuario.Username" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label>Contraseña</label>
                            <input asp-for="@Model.Usuario!.Password_Hash" type="password" class="form-control" placeholder="Mínimo 8 caracteres" />
                            <span asp-validation-for="Usuario.Password_Hash" class="text-danger"></span>
                        </div>

                        <div class="popup-footer" style="gap: 8px;">
                            <input type="submit"
                                   value="Cancelar"
                                   asp-page-handler="BtCancelar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Registrar"
                                   asp-page-handler="BtRegistrar"
                                   class="btn btn-primary" />
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </form>  
}


@if (!Model.EstaLogueado)
{
   <div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div style="width: 400px;">
        <h3>Iniciar Sesión</h3>

        <form method="POST">
            <div class="form-group">
                <label class="control-label">Usuario:</label>
                <input onchange="keyUp(this)"
                       asp-for="@Model.Username"
                       class="form-control" />
            </div>
            <div class="form-group">
                <label class="control-label">Contraseña:</label>
                <input type="password"
                       onchange="keyUp(this)"
                       asp-for="@Model.Password_Hash"
                       class="form-control" />
            </div>

                <div style="text-align: center; margin-top: 20px;">
                    <input type="submit" value="Limpiar" asp-page-handler="BtClean" class="btn btn-outline-secondary" />
                    <input type="submit" value="Entrar" asp-page-handler="BtEnter" class="btn btn-primary" />
                    <input type="submit" value="¿Aun no te registras? REGISTRARSE" asp-page-handler="BtRegistrarse" class="btn btn-default" />
                </div>

                
        </form>
    </div>
</div>
}
