@page
@model Tipo_Aseo_ElementosModel
@{
    ViewData["Title"] = "Tipo Aseo Elementos";
}
<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Tipo_Aseo_Elementos</h3>
            </div>
            
            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Tipo_Aseo_Elemento != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Tipo_Aseo_Elemento == null)" />
            </div>

            @if (Model.Tipo_Aseo_Elemento != null)
            {
                <input type="hidden"
                       asp-for="@Model.Tipo_Aseo_Elemento!.Id_Tipo_Aseo_Elemento" />

                <div>
                    <div class="form-group">
                        <label>
                            Uso
                        </label>
                        <div class="col-6">
                            <input id="inUso"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Tipo_Aseo_Elemento!.Uso" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Instrucciones Uso
                        </label>
                        <div class="col-6">
                            <input id="inInstrucciones_Uso"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Tipo_Aseo_Elemento!.Instrucciones_Uso" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Medida litros
                        </label>
                        <div class="col-6">
                            <input id="inMedida_litros"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Tipo_Aseo_Elemento!.Medida_litros" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Toxicidad
                        </label>
                        <div class="col-6">
                            <input id="inToxicidad"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Tipo_Aseo_Elemento!.Toxicidad" />
                        </div>
                    </div>
                        
                </div>
            }
            
            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Tipo_Aseo_Elemento != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Tipo_Aseo_Elemento?
                            </h6>
                            <h6 align="left">
                                @Model.Tipo_Aseo_Elemento!.Uso
                            </h6>
                            
                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-danger" />
                        </div>
                    </div>
                </div>
            }
            @if (Model != null && Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Uso
                        </th>
                        <th>
                            Instrucciones_Uso
                        </th>
                        <th class="cl_hidden">
                            Medida_litros
                        </th>
                        <th class="cl_hidden">
                            Toxicidad
                        </th>
                        <th class="cl_hidden">
                            Costo
                        </th>
                        <th class="cl_hidden">
                            Portatil
                        </th>
                        <th class="cl_hidden">
                            Bodega
                        </th>
                        <th class="cl_hidden">
                            Tipo Tipo_Aseo_Elemento
                        </th>
                    </tr>
                
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>
                                @elemento.Uso
                            </td>
                            <td>
                                @elemento.Instrucciones_Uso
                            </td>
                            <td class="cl_hidden">
                                @elemento.Medida_litros
                            </td>
                            <td>
                                @elemento.Toxicidad
                            </td>
                            <td>
                                <input type="submit"
                                       value="Modicar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-warning"
                                       asp-route-data="@elemento.Id_Tipo_Aseo_Elemento" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-danger"
                                       asp-route-data="@elemento.Id_Tipo_Aseo_Elemento" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>