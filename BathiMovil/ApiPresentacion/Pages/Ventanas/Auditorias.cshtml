@page
@model AuditoriasModel
@{
    ViewData["Title"] = "Auditorias";
}
<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Auditorias</h3>
            </div>

            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <button asp-page-handler="ExportarPdf"
                        class="btn btn-danger">
                    Exportar PDF
                </button>
            </div>

            @* ── Barra de búsqueda ── *@
            <div class="mb-3 mt-2">
                <input type="text"
                       id="barraBusqueda"
                       class="form-control"
                       placeholder="Buscar por hora, nivel, nombre u operación..."
                       oninput="filtrarTabla()" />
            </div>

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model != null && Model.Lista != null && Model.Lista.Count > 0)
            {
                <table id="tablaAuditorias" class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th class="cl_hidden">Hora de accion</th>
                        <th class="cl_hidden">Nivel del cambio</th>
                        <th>Nombre</th>
                        <th>Operación</th>
                    </tr>

                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>@elemento.HoraAccion</td>
                            <td>@elemento.Nivel_Cambio</td>
                            <td class="cl_hidden">@elemento.Nombre</td>
                            <td class="cl_hidden">@elemento.Operacion</td>
                        </tr>
                    }
                </table>

                <p id="sinResultados" style="display:none; color:gray;">
                    No se encontraron resultados.
                </p>
            }
        </form>
    </div>
</center>

@section Scripts {
    <script>
        function filtrarTabla() {
            const filtro = document.getElementById("barraBusqueda").value.toLowerCase();
            const tabla = document.getElementById("tablaAuditorias");
            const filas = tabla ? tabla.getElementsByTagName("tr") : [];
            let visibles = 0;

            // Empieza en 1 para saltar el encabezado
            for (let i = 1; i < filas.length; i++) {
                const textoFila = filas[i].innerText.toLowerCase();
                const mostrar = textoFila.includes(filtro);
                filas[i].style.display = mostrar ? "" : "none";
                if (mostrar) visibles++;
            }

            // Muestra mensaje si no hay resultados
            const sinResultados = document.getElementById("sinResultados");
            if (sinResultados) {
                sinResultados.style.display = visibles === 0 ? "block" : "none";
            }
        }
    </script>
}