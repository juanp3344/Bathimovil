@page
@model VentasModel
@{
    ViewData["Title"] = "Catalogo";
}

    <h1>@ViewData["Title"]</h1>

    <head>
        <meta charset="UTF-8">
        <title>Catálogo</title>

        <style>
            .catalogo {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
                gap: 20px;
                padding: 20px;
            }

            .producto {
                border: 1px solid #ccc;
                border-radius: 10px;
                padding: 10px;
                text-align: center;
                box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            }

                .producto img {
                    width: 100%;
                    height: 400px;
                    object-fit: cover;
                    border-radius: 8px;
                }

                .producto button {
                    margin-top: 10px;
                    padding: 8px 15px;
                    border: none;
                    background: #007bff;
                    color: white;
                    border-radius: 5px;
                    cursor: pointer;
                }

                    .producto button:hover {
                        background: red;
                    }
        </style>
    </head>
<center>

    <div class="catalogo">

        @foreach (var tipo in Model.ListaTPortatiles!)
        {
            <div class="producto">
                <img src="https://via.placeholder.com/200" alt="">
                <h3>@tipo.Nombre</h3>
                <h3>@tipo.Precio_Actual</h3>

                <form method="post">
                    <input type="hidden" name="Id" value="@tipo.Id_Tipo_Portatil" />
                    <input type="submit"
                           value="Comprar"
                           asp-page-handler="BtComprarPortatil"
                           class="btn btn-primary" />
                </form>
            </div>
        }

    </div>

    <form method="post">
        @if (Model!.ConfirmarCantidad)
        {
            <div class='popup'>
                <div class='pp_ms_inner'>
                    <div style='width:95%'>

                        <input type="hidden" asp-for="Id" />
                        <div class="form-group d-flex flex-column align-items-center">
                            <label>
                                INGRESE LA CANTIDAD
                            </label>
                            <div class="col-6">
                                <input id="inCantidad"
                                       class="cts_forms form-control"
                                       asp-for="@Model.Cantidad" />

                                <span asp-validation-for="Cantidad"
                                      class="text-danger d-block text-center"></span>
                            </div>
                        </div>
                        <div class="popup-footer">
                            <input type="submit"
                                   value="Aceptar"
                                   asp-page-handler="BtAceptar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            </div>
        }
       
    </form>

</center>