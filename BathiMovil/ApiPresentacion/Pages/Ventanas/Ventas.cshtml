@page
@model VentasModel
@{
    ViewData["Title"] = "Catalogo";
}

    <h1>@ViewData["Title"]</h1>

    <head>
        <meta charset="UTF-8">
        <title>Catálogo</title>

        <style>
            .catalogo {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
                gap: 20px;
                padding: 20px;
            }

            .producto {
                border: 1px solid #ccc;
                border-radius: 10px;
                padding: 10px;
                text-align: center;
                box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            }

                .producto img {
                    width: 100%;
                    height: 400px;
                    object-fit: cover;
                    border-radius: 8px;
                }

                .producto button {
                    margin-top: 10px;
                    padding: 8px 15px;
                    border: none;
                    background: #007bff;
                    color: white;
                    border-radius: 5px;
                    cursor: pointer;
                }

                    .producto button:hover {
                        background: red;
                    }
        </style>
    </head>
<center>

    <div class="catalogo">

        @foreach (var tipo in Model.ListaTPortatiles!)
        {
            <div class="producto">
                <img src= "@tipo.ImagenUrl" alt="@tipo.Nombre">
                <h3>@tipo.Nombre</h3>
                <h3>@tipo.Precio_Actual</h3>

                <form method="post">
                    <input type="hidden" name="Id" value="@tipo.Id_Tipo_Portatil" />
                    <input type="submit"
                           value="Comprar"
                           asp-page-handler="BtComprarPortatil"
                           class="btn btn-primary" />
                </form>
            </div>
        }

    </div>

    @if (Model.NoEstaLogeado)
    {
        <div class="popup">
            <div class="popup-dialog">
                <div class="popup-body">
                    <div class="popup-icon">⚠️</div>
                    <div>
                        <p class="popup-title">No esta logueado</p>
                        <p class="popup-message">
                            Debes de estar <strong>logueado</strong> para comprar o prestar un baño portatil.
                        </p>
                    </div>
                </div>
                 <form method="post">
                <div class="popup-footer">
                    <input type="submit"
                           value="Cerrar"
                           asp-page-handler="BtCerrar"
                           class="btn btn-danger" />
                </div>
                </form>
            </div>
        </div>
    }

    <form method="post">
        @if (Model!.ConfirmarCantidad)
{
    <div class="modal-overlay">
        <div class="modal-box">
            <form method="post">
                <input type="hidden" asp-for="Id" />

                <div class="modal-icon">
                    <i class="ti ti-package"></i>
                </div>

                <p class="modal-title">Ingresar cantidad</p>
                <p class="modal-sub">Especifica el valor antes de continuar</p>

                <input id="inCantidad"
                       type="number"
                       class="modal-input"
                       asp-for="@Model.Cantidad"
                       placeholder="0" />

                <span asp-validation-for="Cantidad" class="modal-error"></span>

                <div class="modal-btn-row">
                    <input type="submit"
                           value="Aceptar"
                           asp-page-handler="BtAceptar"
                           class="btn-accept" />
                    <input type="submit"
                           value="Cerrar"
                           asp-page-handler="BtCerrar"
                           class="btn-close" />
                </div>
            </form>
        </div>
    </div>
}
       
    </form>

</center>