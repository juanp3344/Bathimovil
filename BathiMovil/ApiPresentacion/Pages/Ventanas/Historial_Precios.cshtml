@page
@model HistorialPreciosModel
@{
    ViewData["Title"] = "Historial Precios";
}
<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Historial Precio</h3>
            </div>
            
            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Historial_Precio != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Historial_Precio == null)" />
            </div>

            @if (Model.Historial_Precio != null)
            {
                <input type="hidden"
                       asp-for="@Model.Historial_Precio!.Id_Historial" />

                <div>
                    <div class="form-group">
                        <label>
                            Valor
                        </label>
                        <div class="col-6">
                            <input id="inValor"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Historial_Precio!.Valor" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Fecha Inicio
                        </label>
                        <div class="col-6">
                            <input id="inFecha_Inicio"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Historial_Precio!.Fecha_Inicio" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Fecha Fin
                        </label>
                        <div class="col-6">
                            <input id="inFecha_Fin"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Historial_Precio!.Fecha_Fin" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Motivo Cambio
                        </label>
                        <div class="col-6">
                            <input id="inMotivo_Cambio"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Historial_Precio!.Motivo_Cambio" />
                        </div>
                        
                </div>
                    <div class="form-group">
                        <label>
                            Tipo Portatil
                        </label>
                        <div class="col-6">
                            <input id="inTipo_Portatil"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Historial_Precio!.Tipo_Portatil" />
                        </div>

                    </div>
                </div>
            }
            
            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Historial_Precio != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Historial_Precio?
                            </h6>
                            <h6 align="left">
                                @Model.Historial_Precio!.Valor
                            </h6>
                            
                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-danger" />
                        </div>
                    </div>
                </div>
            }
            @if (Model != null && Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Valor
                        </th>
                        <th>
                            Fecha Inicio
                        </th>
                        <th class="cl_hidden">
                            Fecha Fin
                        </th>
                        <th class="cl_hidden">
                            Motivo Cambio
                        </th>
                        <th class="cl_hidden">
                            Tipo Portatil
                        </th>
                    </tr>
                
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>
                                @elemento.Valor
                            </td>
                            <td>
                                @elemento.Fecha_Inicio
                            </td>
                            <td class="cl_hidden">
                                @elemento.Fecha_Fin
                            </td>
                            <td class="cl_hidden">
                                @elemento.Motivo_Cambio
                            </td>
                            <td class="cl_hidden">
                                @elemento.Tipo_Portatil
                            </td>
                            <td>
                                <input type="submit"
                                       value="Modicar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-warning"
                                       asp-route-data="@elemento.Id_Historial" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-danger"
                                       asp-route-data="@elemento.Id_Historial" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>