@page
@model BodegasModel
@{
    ViewData["Title"] = "Bodegas";
}
<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Bodegas</h3>
            </div>
            
            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Bodega != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Bodega == null)" />
            </div>

            @if (Model.Bodega != null)
            {
                <input type="hidden"
                       asp-for="@Model.Bodega!.Id_Bodega" />

                <div>
                    <div class="form-group">
                        <label>
                            Nombre
                        </label>
                        <div class="col-6">
                            <input id="inNombre"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Bodega!.Nombre" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Ubicacion
                        </label>
                        <div class="col-6">
                            <input id="inNombre"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Bodega!.Ubicacion" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Capacidad Maxima
                        </label>
                        <div class="col-6">
                            <input id="inCapacidad_Maxima"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Bodega!.Capacidad_Maxima" />
                        </div>
                    </div>
                    <div style="margin-top: 20px;">
                        <select id="nmRoles"
                                class="form-control"
                                asp-for="@Model.Bodega!.Empleado"
                                asp-items="@(new SelectList(Model.CargarEmpleados(), "Id_Persona", "Nombre"))">
                            <option value="">-- Seleccione un rol --</option>
                        </select>
                    </div>

                    <div style="margin-top: 20px;">
                        <select id="nmRoles"
                                class="form-control"
                                asp-for="@Model.Bodega!.Sede"
                                asp-items="@(new SelectList(Model.CargarSedes(), "Id_Sede", "Nombre"))">
                            <option value="">-- Seleccione un rol --</option>
                        </select>
                    </div>
                </div>
                
            }
            
            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Bodega != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Bodega?
                            </h6>
                            <h6 align="left">
                                @Model.Bodega!.Nombre
                            </h6>
                            
                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }
            @if (Model != null && Model.Lista != null &&  Model.Lista.Count > 0)
            {
            <table class="tb_data table table-striped table-bordered table-hover">
                <tr>
                    <th>
                        Nombre
                    </th>
                    <th>
                        Ubicacion
                    </th>
                    <th class="cl_hidden">
                        Capacidad_Maxima
                    </th>
                     <th class="cl_hidden">
                        Empleado
                    </th>
                        <th class="cl_hidden">
                            Sede
                        </th>
                    <th class="cl_actions">
                        Acción
                    </th>
                </tr>
                
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>
                                @elemento.Nombre
                            </td>
                            <td>
                                @elemento.Ubicacion
                            </td>
                            <td>
                                @elemento.Capacidad_Maxima
                            </td>
                            <td>
                                @elemento.Empleado
                            </td>
                            <td>
                                @elemento.Sede
                            </td>
                            <td>
                                <input type="submit"
                                       value="Modicar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id_Bodega" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id_Bodega" />
                            </td>
                        </tr>
                }
            </table>
            }
        </form>
    </div>
</center>