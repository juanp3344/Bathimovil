

@page
@model ContratosModel
@{
    ViewData["Title"] = "Contratos";
}
<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Portatil" />
            <div align="left">
                <h3>Contratos</h3>
            </div>
            
            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" 
                       disabled="@(Model.VienePorCompra)" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Contrato != null || Model.VienePorCompra)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Contrato == null || Model.VienePorCompra)" />
            </div>

            @if (Model.Contrato != null)
            {
                <input type="hidden"
                       asp-for="@Model.Contrato!.Id_Contrato" />

                <div>
                    <div style="margin-top: 20px;">
                        <label>
                            Fecha Firma
                        </label>
                        <div class="col-6">
                            <input id="inFecha_Firma"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Contrato!.Fecha_Firma"
                                   readonly="@Model.VienePorCompra" 
                                   style="margin-top: 5px;" />
                        </div>
                    </div>
                    <div style="margin-top: 20px;">
                        <label>
                            Terminos
                        </label>
                        <div class="col-6">
                            <input id="inFecha_Firma"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Contrato!.Terminos" 
                                   readonly="@Model.VienePorCompra"
                                   style="margin-top: 5px;" />
                        </div>
                    </div>
                    <div style="margin-top: 20px;">
                        <label>
                            Fecha Expiracion
                        </label>
                        <div class="col-6">
                            <input id="inFecha_Expiracion"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Contrato!.Fecha_Expiracion" 
                                   style="margin-top: 5px;" />
                        </div>
                    </div>

                    <div style="margin-top: 20px;">
                        <select id="nmCliente"
                                class="form-control"
                                asp-for="@Model.Contrato!.Cliente"
                                asp-items="@(new SelectList(Model.CargarClientes(), "Id_Persona", "Nombre"))"
                                disabled="@(Model.VienePorCompra ? "disabled" : null)">
                            <option value="">-- Seleccione un cliente --</option>
                        </select>
                    </div>

                    
                </div>

                
                
            }

            @if (Model.VienePorPrestamo)
            {
                <input type="hidden" asp-for="@Model.Contrato!.Cliente" />
                <input type="hidden" asp-for="@Model.Contrato!.Fecha_Firma" />
                <input type="hidden" asp-for="@Model.Contrato!.Terminos" />
                <input type="hidden" asp-for="@Model.Contrato!.Fecha_Expiracion" />
                <input type="hidden" asp-for="CantidadCalculo" />
                <input type="hidden" asp-for="Portatil" />
                <input type="hidden" asp-for="VienePorPrestamo" />
                <input type="submit"
                       value="Firmar"
                       asp-page-handler="BtFirmarPrestamo"
                       class="btn btn-secondary"
                       style="margin-top: 50px;" />
            }
            else if (Model.VienePorCompra)
            {
                <input type="hidden" asp-for="@Model.Contrato!.Cliente" />
                <input type="hidden" asp-for="@Model.Contrato!.Fecha_Firma" />
                <input type="hidden" asp-for="@Model.Contrato!.Terminos" />
                <input type="hidden" asp-for="@Model.Contrato!.Fecha_Expiracion" />
                <input type="hidden" asp-for="CantidadCalculo" />
                <input type="hidden" asp-for="Portatil" />
                <input type="submit"
                       value="Firmar"
                       asp-page-handler="BtFirmar"
                       class="btn btn-secondary"
                       style="margin-top: 50px;" />
            }
        

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Contrato != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Contrato?
                            </h6>
                            <h6 align="left">
                                @Model.Contrato!.Fecha_Firma
                            </h6>
                            
                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>

                @* Hidden fields to ensure values are posted even if UI controls are disabled *@
                <input type="hidden" asp-for="@Model.Contrato!.Cliente" />
                <input type="hidden" asp-for="@Model.Contrato!.Fecha_Firma" />
                <input type="hidden" asp-for="@Model.Contrato!.Terminos" />
                <input type="hidden" asp-for="@Model.Contrato!.Fecha_Expiracion" />
            }
            @if (Model != null && Model.Lista != null &&  Model.Lista.Count > 0)
            {
            <table class="tb_data table table-striped table-bordered table-hover">
                <tr>
                    <th>
                        Fecha Firma
                    </th>
                    <th>
                        Terminos
                    </th>
                    <th class="cl_hidden">
                        Fecha_Expiracion
                    </th>
                      <th class="cl_hidden">
                        Cliente
                     </th>
                    <th class="cl_actions">
                        Acción
                    </th>
                </tr>
                
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>
                                @elemento.Fecha_Firma
                            </td>
                            <td>
                                @elemento.Terminos
                            </td>
                            <td class="cl_hidden">
                                @elemento.Fecha_Expiracion
                            </td>
                            <td class="cl_hidden">
                                @elemento.Cliente
                            </td>
                            <td>
                                <input type="submit"
                                       value="Modicar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id_Contrato" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id_Contrato" />
                            </td>
                        </tr>
                }
            </table>
            }
        </form>
    </div>
</center>