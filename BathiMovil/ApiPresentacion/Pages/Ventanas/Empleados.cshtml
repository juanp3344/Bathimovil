@page
@model EmpleadosModel
@{
    ViewData["Title"] = "Empleados";
}
<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Empleados</h3>
            </div>
            
            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Empleado != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Empleado == null)" />
                <button asp-page-handler="ExportarPdf"
                        class="btn btn-danger">
                    Exportar PDF
                </button>
            </div>

            @if (Model.Empleado != null)
            {
                <input type="hidden"
                       asp-for="@Model.Empleado!.Id_Persona" />

                <div>
                    <div class="form-group">
                        <label>
                            Cedula
                        </label>
                        <div class="col-6">
                            <input id="inCedula"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Empleado!.Cedula" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Nombre
                        </label>
                        <div class="col-6">
                            <input id="inNombre"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Empleado!.Nombre" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Correo
                        </label>
                        <div class="col-6">
                            <input id="inCorreo"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Empleado!.Correo" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Telefono
                        </label>
                        <div class="col-6">
                            <input id="inTelefono"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Empleado!.Telefono" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Fecha Ingreso
                        </label>
                        <div class="col-6">
                            <input id="inFecha_Ingreso"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Empleado!.Fecha_Ingreso" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Salario Base
                        </label>
                        <div class="col-6">
                            <input id="inSalario_Base"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Empleado!.Salario_Base" />
                        </div>
                    </div>
                </div>
            }
            
            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Empleado != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Empleado?
                            </h6>
                            <h6 align="left">
                                @Model.Empleado!.Cedula
                            </h6>
                            
                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }
            @if (Model != null && Model.Lista != null &&  Model.Lista.Count > 0)
            {
            <table class="tb_data table table-striped table-bordered table-hover">
                <tr>
                    <th>
                        Cedula
                    </th>
                    <th>
                        Nombre
                    </th>
                    <th class="cl_hidden">
                        Correo
                    </th>
                      <th class="cl_hidden">
                        Telefono
                     </th>
                     <th class="cl_hidden">
                        Fecha de Ingreso
                     </th>
                      <th>
                         Salario Base
                      </th>
                    <th class="cl_actions">
                        Acción
                    </th>
                </tr>
                
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>
                                @elemento.Cedula
                            </td>
                            <td>
                                @elemento.Nombre
                            </td>
                            <td class="cl_hidden">
                                @elemento.Correo
                            </td>
                            <td class="cl_hidden">
                                @elemento.Telefono
                            </td>
                            <td class="cl_hidden">
                                @elemento.Fecha_Ingreso
                            </td>
                            <td>
                                @elemento.Salario_Base
                            </td>
                            <td>
                                <input type="submit"
                                       value="Modicar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id_Persona" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id_Persona" />
                            </td>
                        </tr>
                }
            </table>
            }
        </form>
    </div>
</center>