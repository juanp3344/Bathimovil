@page
@model AseoElementosModel
@{
    ViewData["Title"] = "Aseo Elementos";
}
<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Aseo Elementos</h3>
            </div>
            
            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Aseo_Elemento != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Aseo_Elemento == null)" />
            </div>

            @if (Model.Aseo_Elemento != null)
            {
                <input type="hidden"
                       asp-for="@Model.Aseo_Elemento!.Id_Aseo_Elemento" />

                <div>
                    <div class="form-group">
                        <label>
                            Fecha_Vencimiento
                        </label>
                        <div class="col-6">
                            <input id="inFecha_Vencimiento"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Aseo_Elemento!.Fecha_Vencimiento" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Cantidad
                        </label>
                        <div class="col-6">
                            <input id="inNombre"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Aseo_Elemento!.Cantidad" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Marca
                        </label>
                        <div class="col-6">
                            <input id="inMarca"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Aseo_Elemento!.Marca" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Costo
                        </label>
                        <div class="col-6">
                            <input id="inCosto"
                                   asp-for="@Model.Aseo_Elemento!.Costo" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Mantenimiento
                        </label>
                        <div class="col-6">
                            <input id="inMantenimiento"
                                   asp-for="@Model.Aseo_Elemento!.Mantenimiento" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Tipo Aseo Elementos
                        </label>
                        <div class="col-6">
                            <input id="inTipo_Aseo_Elementos"
                                   asp-for="@Model.Aseo_Elemento!.Tipo_Aseo_Elemento" />
                        </div>
                    </div>
                </div>
            }
            
            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Aseo_Elemento != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Aseo_Elemento?
                            </h6>
                            <h6 align="left">
                                @Model.Aseo_Elemento!.Fecha_Vencimiento
                            </h6>
                            
                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }
            @if (Model != null && Model.Lista != null &&  Model.Lista.Count > 0)
            {
            <table class="tb_data table table-striped table-bordered table-hover">
                <tr>
                    <th>
                        Fecha_Vencimiento
                    </th>
                    <th>
                        Cantidad
                    </th>
                    <th class="cl_hidden">
                        Costo
                    </th>
                    <th class="cl_hidden">
                        Marca
                    </th>
                    <th class="cl_hidden">
                        Mantenimiento
                    </th>
                     <th class="cl_hidden">
                        Tipo Aseo Elementos
                     </th>
                    <th class="cl_actions">
                        Acción
                    </th>
                </tr>
                
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>
                                @elemento.Fecha_Vencimiento
                            </td>
                            <td>
                                @elemento.Cantidad
                            </td>
                            <td class="cl_hidden">
                                @elemento.Costo
                            </td>
                            <td class="cl_hidden">
                                @elemento.Marca
                            </td>
                            <td class="cl_hidden">
                                @elemento.Mantenimiento
                            </td>
                            <td class="cl_hidden">
                                @elemento.Tipo_Aseo_Elemento
                            </td>
                            <td>
                                <input type="submit"
                                       value="Modicar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id_Aseo_Elemento" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id_Aseo_Elemento" />
                            </td>
                        </tr>
                }
            </table>
            }
        </form>
    </div>
</center>