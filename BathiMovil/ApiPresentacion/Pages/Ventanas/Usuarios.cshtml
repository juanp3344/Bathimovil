@page
@model UsuariosModel
@{
    ViewData["Title"] = "Usuarios";
}
<center>
    <div>

        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

           
            <div align="left">
                <h3>Usuarios</h3>
            </div>

            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Usuario != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Usuario == null)" />
            </div>

            @if (Model.Usuario != null)
            {
                <input type="hidden"
                       asp-for="@Model.Usuario!.Id_Usuario" />
                <input type="hidden" asp-for="rolesLista" />
                <div>
                    <div class="form-group">
                        <label>
                            Username
                        </label>
                        <div class="col-6">
                            <input id="inUsername"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Usuario!.Username" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Password_Hash
                        </label>
                        <div class="col-6">
                            <input id="inPassword_Hash"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Usuario!.Password_Hash" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Activo
                        </label>
                        <div class="col-6">
                            <input id="inActivo"
                                   asp-for="@Model.Usuario!.Activo" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Fecha_Ultimo_Acceso
                        </label>
                        <div class="col-6">
                            <input id="inFecha_Ultimo_Acceso"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Usuario!.Fecha_Ultimo_Acceso" />
                        </div>
                    </div>
                    <div style="margin-top: 20px;">
                        <select id="nmPersonas"
                                class="form-control"
                                asp-for="@Model.Usuario!.Persona"
                                asp-items="@(new SelectList(Model.CargarPersonas(), "Id_Persona", "Nombre"))">
                            <option value="">-- Seleccione una persona --</option>
                        </select>
                    </div>

                    <div style="margin-top: 20px;">
                        <select id="nmRoles"
                                class="form-control"
                                asp-for="@Model.Usuario!.Rol"
                                asp-items="@(new SelectList(Model.CargarRoles(), "Id_Rol", "Nombre_Rol"))">
                            <option value="">-- Seleccione un rol --</option>
                        </select>
                    </div>

                </div>
            }


            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Escliente)
            {
                <div class="popup">
                    <div class="popup-dialog">
                        <div class="popup-body">
                            <div class="popup-icon">⚠️</div>
                            <div>
                                <p class="popup-title">Rol no permitido</p>
                                <p class="popup-message">
                                    Un cliente no puede tener el rol de <strong>administrador</strong> ni de <strong>empleado</strong>.
                                </p>
                            </div>
                        </div>
                        <div class="popup-footer">
                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtSeguirRegistrando"
                                   class="btn btn-danger" />
                        </div>
                    </div>
                </div>
            }

            @if (Model.Usuario != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Usuario?
                            </h6>
                            <h6 align="left">
                                @Model.Usuario!.Username
                            </h6>

                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-danger" />
                        </div>
                    </div>
                </div>
            }
            @if (Model != null && Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Username
                        </th>
                        <th>
                            Password_Hash
                        </th>
                        <th class="cl_hidden">
                            Activo
                        </th>
                        <th class="cl_hidden">
                            Fecha_Ultimo_Acceso
                        </th>
                        <th class="cl_hidden">
                            Persona
                        </th>
                        <th class="cl_hidden">
                            Rol
                        </th>
                    </tr>

                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>
                                @elemento.Username
                            </td>
                            <td>
                                @elemento.Password_Hash
                            </td>
                            <td class="cl_hidden">
                                @elemento.Activo
                            </td>
                            <td>
                                @elemento.Fecha_Ultimo_Acceso
                            </td>
                            <td class="cl_hidden">
                                @elemento.Persona
                            </td>
                            <td class="cl_hidden">
                                @elemento.Rol
                            </td>
                            <td>
                                <input type="submit"
                                       value="Modicar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-warning"
                                       asp-route-data="@elemento.Id_Usuario" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-danger"
                                       asp-route-data="@elemento.Id_Usuario" />
                            </td>
                        </tr>
                    }
                </table>
            }

        </form>
    </div>
</center>