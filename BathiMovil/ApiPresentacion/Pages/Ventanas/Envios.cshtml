@page
@model EnviosModel
@{
    ViewData["Title"] = "Envios";
}
<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Envios</h3>
            </div>
            
            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Envio != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Envio == null)" />
            </div>

            @if (Model.Envio != null)
            {
                <input type="hidden"
                       asp-for="@Model.Envio!.Id_Envio" />

                <div>
                    <div class="form-group">
                        <label>
                            Fecha de Salida
                        </label>
                        <div class="col-6">
                            <input id="inFecha_Salida"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Envio!.Fecha_Salida" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Destino
                        </label>
                        <div class="col-6">
                            <input id="inDestino"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Envio!.Destino" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Costo de Envio
                        </label>
                        <div class="col-6">
                            <input id="inCosto_Envio"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Envio!.Costo_Envio" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Fecha Entrega Estimada
                        </label>
                        <div class="col-6">
                            <input id="inFecha_Entrega_Estimada"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Envio!.Fecha_Entrega_Estimada" />
                        </div>
                   
                </div>
                <div class="form-group">
                        <label>
                            Contrato
                        </label>
                        <div class="col-6">
                            <input id="inContrato"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Envio!.Contrato" />
                        </div>
                   
                </div>
                    <div class="form-group">
                        <label>
                           Empleado
                        </label>
                        <div class="col-6">
                            <input id="inEmpleado"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Envio!.Empleado" />
                        </div>

                    </div>
                </div>
            }
            
            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Envio != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Envio?
                            </h6>
                            <h6 align="left">
                                @Model.Envio!.Fecha_Salida
                            </h6>
                            
                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }
            @if (Model != null && Model.Lista != null &&  Model.Lista.Count > 0)
            {
            <table class="tb_data table table-striped table-bordered table-hover">
                <tr>
                    <th>
                        Fecha_Salida
                    </th>
                    <th>
                        Destino
                    </th>
                    <th class="cl_hidden">
                        Costo Envio
                    </th>
                      <th>
                        Fecha Entrega Estimada
                     </th>
                      <th>
                        Contrato
                     </th>
                        <th>
                            Empleado
                        </th>
                   
                    <th class="cl_actions">
                        Acción
                    </th>
                </tr>
                
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>
                                @elemento.Fecha_Salida
                            </td>
                            <td>
                                @elemento.Destino
                            </td>
                            <td class="cl_hidden">
                                @elemento.Costo_Envio
                            </td>
                            <td class="cl_hidden">
                                @elemento.Fecha_Entrega_Estimada
                            </td>
                            <td class="cl_hidden">
                                @elemento.Contrato
                            </td>
                            <td class="cl_hidden">
                                @elemento.Empleado
                            </td>
                            <td>
                                <input type="submit"
                                       value="Modicar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id_Envio" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id_Envio" />
                            </td>
                        </tr>
                }
            </table>
            }
        </form>
    </div>
</center>