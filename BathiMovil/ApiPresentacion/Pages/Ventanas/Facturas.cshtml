@page
@model FacturasModel
@{
    ViewData["Title"] = "Facturas";
}
<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Facturas</h3>
            </div>

            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Factura != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Factura == null)" />
            </div>

            @if (Model.Factura != null)
            {
                <input type="hidden"
                       asp-for="@Model.Factura!.Id_Factura" />

                <div>
                    <div class="form-group">
                        <label>
                            Numero
                        </label>
                        <div class="col-6">
                            <input id="inNumero"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Factura!.Numero" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Fecha Emision
                        </label>
                        <div class="col-6">
                            <input id="inFecha_Emision"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Factura!.Fecha_Emision" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Total
                        </label>
                        <div class="col-6">
                            <input id="inTotal"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Factura!.Total" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Impuesto Iva
                        </label>
                        <div class="col-6">
                            <input id="inImpuesto_Iva"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Factura!.Impuesto_Iva" />
                        </div>

                    </div>

                    <div style="margin-top: 20px;">
                        <select id="nmCliente"
                                class="form-control"
                                asp-for="@Model.Factura!.Cliente"
                                asp-items="@(new SelectList(Model.CargarClientes(), "Id_Persona", "Nombre"))">
                            <option value="">-- Seleccione un cliente --</option>
                        </select>
                    </div>
                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Factura != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Factura?
                            </h6>
                            <h6 align="left">
                                @Model.Factura!.Numero
                            </h6>

                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }
            @if (Model != null && Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Numero
                        </th>
                        <th>
                            Fecha Emision
                        </th>
                        <th class="cl_hidden">
                            Total
                        </th>
                        <th class="cl_hidden">
                            Impuesto Iva
                        </th>
                        <th class="cl_hidden">
                            Cliente
                        </th>
                        <th class="cl_actions">
                            Acción
                        </th>
                    </tr>

                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>
                                @elemento.Numero
                            </td>
                            <td>
                                @elemento.Fecha_Emision
                            </td>
                            <td class="cl_hidden">
                                @elemento.Total
                            </td>
                            <td class="cl_hidden">
                                @elemento.Impuesto_Iva
                            </td>
                            <td class="cl_hidden">
                                @elemento.Cliente
                            </td>
                            <td>
                                <input type="submit"
                                       value="Modicar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id_Factura" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id_Factura" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>