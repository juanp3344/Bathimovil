@page
@model PortatilesModel
@{
    ViewData["Title"] = "Portatiles";
}
<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Portatiles</h3>
            </div>

            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Portatil != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Portatil == null)" />
            </div>


            @if (Model.ErrorRol)
            {
                <div class="popup">
                    <div class="popup-dialog">
                        <div class="popup-body">
                            <div class="popup-icon">⚠️</div>
                            <div>
                                <p class="popup-title">Rol no permitido</p>
                                <p class="popup-message">
                                    El rol que tienes <strong>NO</strong> es valido para esta opción.
                                </p>
                            </div>
                        </div>
                        <div class="popup-footer">
                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtVolver"
                                   class="btn btn-danger" />
                        </div>
                    </div>
                </div>
            }

            @if (Model.Portatil != null)
            {
                <input type="hidden"
                       asp-for="@Model.Portatil!.Id_Portatil" />

                <div>
                    <div class="form-group">
                        <label>
                            Numero_Serial
                        </label>
                        <div class="col-6">
                            <input id="inNumero_Serial"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Portatil!.Numero_Serial" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Fecha_Fabricacion
                        </label>
                        <div class="col-6">
                            <input id="inFecha_Fabricacion"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Portatil!.Fecha_Fabricacion" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Estado_Actual
                        </label>
                        <div class="col-6">
                            <input id="inEstado_Actual"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Portatil!.Estado_Actual" />
                        </div>
                    </div>

                    <div style="margin-top: 20px;">
                        <select id="nmSede"
                                class="form-control"
                                asp-for="@Model.Portatil!.Sede"
                                asp-items="@(new SelectList(Model.CargarSedes(), "Id_Sede", "Nombre"))">
                            <option value="">-- Seleccione una sede--</option>
                        </select>
                    </div>

                    <div style="margin-top: 20px;">
                        <select id="nmCompra"
                                class="form-control"
                                asp-for="@Model.Portatil!.Compra"
                                asp-items="@(new SelectList(Model.CargarCompras(), "Id_Compra", "Contrato"))">
                            <option value="">-- Seleccione una sede--</option>
                        </select>
                    </div>

                    <div style="margin-top: 20px;">
                        <select id="nmSede"
                                class="form-control"
                                asp-for="@Model.Portatil!.Tipo_Portatil"
                                asp-items="@(new SelectList(Model.CargarTipos(), "Id_Tipo_Portatil", "Nombre"))">
                            <option value="">-- Seleccione un tipo portatil--</option>
                        </select>
                    </div>
                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Portatil != null && Model.Borrando)
            {
                <div class="popup">
                    <div class="popup-dialog">
                        <div class="popup-body">
                            <div class="popup-icon">⚠️</div>
                            <div>
                                <h6 align="left">
                                    @Model.Portatil!.Numero_Serial
                                </h6>
                                <p class="popup-title">Eliminar bañor portatil</p>
                                <p class="popup-message">
                                    ESTAS SEGURO DE <strong>ELIMINAR</strong> ESTE BAÑO
                                </p>
                            </div>
                        </div>
                        <input type="submit"
                               value="Cerrar"
                               asp-page-handler="BtCerrar"
                               class="btn btn-secondary" />
                        <input type="submit"
                               value="Borrar"
                               asp-page-handler="BtBorrar"
                               class="btn btn-danger" />
                    </div>
                </div>
            }
            @if (Model != null && Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Numero_Serial
                        </th>
                        <th>
                            Fecha_Fabricacion
                        </th>
                        <th class="cl_hidden">
                            Estado_Actual
                        </th>
                        <th class="cl_hidden">
                            Sede
                        </th>
                        <th class="cl_hidden">
                            Compra
                        </th>
                        <th class="cl_hidden">
                            Tipo Portatil
                        </th>
                    </tr>

                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>
                                @elemento.Numero_Serial
                            </td>
                            <td>
                                @elemento.Fecha_Fabricacion
                            </td>
                            <td>
                                @elemento.Estado_Actual
                            </td>
                            <td class="cl_hidden">
                                @elemento.Sede
                            </td>
                            <td class="cl_hidden">
                                @elemento.Compra
                            </td>
                            <td class="cl_hidden">
                                @elemento.Tipo_Portatil
                            </td>
                            <td>
                                <input type="submit"
                                       value="Modicar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-warning"
                                       asp-route-data="@elemento.Id_Portatil" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-danger"
                                       asp-route-data="@elemento.Id_Portatil" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>