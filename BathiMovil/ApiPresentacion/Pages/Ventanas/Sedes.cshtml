@page
@model SedesModel
@{
    ViewData["Title"] = "Sedes";
}
<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Sedes</h3>
            </div>
            
            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Sede != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Sede == null)" />
            </div>

            @if (Model.Sede != null)
            {
                <input type="hidden"
                       asp-for="@Model.Sede!.Id_Sede" />

                <div>
                    <div class="form-group">
                        <label>
                            Nombre
                        </label>
                        <div class="col-6">
                            <input id="inNombre"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Sede!.Nombre" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Direccion
                        </label>
                        <div class="col-6">
                            <input id="inDireccion"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Sede!.Direccion" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Ciudad
                        </label>
                        <div class="col-6">
                            <input id="inCiudad"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Sede!.Ciudad" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Telefono_Contacto
                        </label>
                        <div class="col-6">
                            <input id="inTelefono_Contacto"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Sede!.Telefono_Contacto" />
                        </div>
                    </div>
                </div>
            }
            
            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Sede != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Sede?
                            </h6>
                            <h6 align="left">
                                @Model.Sede!.Nombre
                            </h6>
                            
                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-danger" />
                        </div>
                    </div>
                </div>
            }
            @if (Model != null && Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Nombre
                        </th>
                        <th>
                            Direccion
                        </th>
                        <th class="cl_hidden">
                            Ciudad
                        </th>
                        <th class="cl_hidden">
                            Telefono_Contacto
                        </th>
                        <th class="cl_hidden">
                            Costo
                        </th>
                    </tr>
                
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>
                                @elemento.Nombre
                            </td>
                            <td>
                                @elemento.Direccion
                            </td>
                            <td class="cl_hidden">
                                @elemento.Ciudad
                            </td>
                            <td>
                                @elemento.Telefono_Contacto
                            </td>
                            <td>
                                <input type="submit"
                                       value="Modicar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-warning"
                                       asp-route-data="@elemento.Id_Sede" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-danger"
                                       asp-route-data="@elemento.Id_Sede" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>