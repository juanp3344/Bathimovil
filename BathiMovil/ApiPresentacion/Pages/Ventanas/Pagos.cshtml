@page
@model PagosModel
@{
    ViewData["Title"] = "Pagos";
}
<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Pagos</h3>
            </div>

            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Pago != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Pago == null)" />
            </div>

            @if (Model.Pago != null)
            {
                <input type="hidden"
                       asp-for="@Model.Pago!.Id_Pago" />

                <div>
                    <div class="form-group">
                        <label>
                            Total_Pagado
                        </label>
                        <div class="col-6">
                            <input id="inTotal_Pagado"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Pago!.Total_Pagado" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Fecha_Pago
                        </label>
                        <div class="col-6">
                            <input id="inFecha_Pago"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Pago!.Fecha_Pago" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Referencia_Bancaria
                        </label>
                        <div class="col-6">
                            <input id="inReferencia_Bancaria"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Pago!.Referencia_Bancaria" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Metodo_Pago
                        </label>
                        <div class="col-6">
                            <input id="inMetodo_Pago"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Pago!.Metodo_Pago" />
                        </div>
                    </div>

                    <div style="margin-top: 20px;">
                        <select id="nmFactura"
                                class="form-control"
                                asp-for="@Model.Pago!.Factura"
                                asp-items="@(new SelectList(Model.CargarFacturas(), "Id_Factura", "Numero"))">
                            <option value="">-- Seleccione una factura --</option>
                        </select>
                    </div>

                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Pago != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Pago?
                            </h6>
                            <h6 align="left">
                                @Model.Pago!.Total_Pagado
                            </h6>

                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-danger" />
                        </div>
                    </div>
                </div>
            }
            @if (Model != null && Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Total_Pagado
                        </th>
                        <th>
                            Fecha_Pago
                        </th>
                        <th class="cl_hidden">
                            Referencia_Bancaria
                        </th>
                        <th class="cl_hidden">
                            Metodo_Pago
                        </th>
                        <th class="cl_hidden">
                            Factura
                        </th>
                    </tr>

                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>
                                @elemento.Total_Pagado
                            </td>
                            <td>
                                @elemento.Fecha_Pago
                            </td>
                            <td class="cl_hidden">
                                @elemento.Referencia_Bancaria
                            </td>
                            <td>
                                @elemento.Metodo_Pago
                            </td>
                            <td class="cl_hidden">
                                @elemento.Factura
                            </td>
                            <td>
                                <input type="submit"
                                       value="Modicar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-warning"
                                       asp-route-data="@elemento.Id_Pago" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-danger"
                                       asp-route-data="@elemento.Id_Pago" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>