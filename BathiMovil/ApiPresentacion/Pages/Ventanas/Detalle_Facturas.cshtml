@page
@model Detalle_FacturasModel
@{
    ViewData["Title"] = "Detalle facturas";
}
<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Detalle facturas</h3>
            </div>

            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Detalle_Factura != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Detalle_Factura == null)" />
            </div>

            @if (Model.Detalle_Factura != null)
            {
                <input type="hidden"
                       asp-for="@Model.Detalle_Factura!.Id_Detalle" />

                <div>
                    <div class="form-group">
                        <label>
                            Cantidad
                        </label>
                        <div class="col-6">
                            <input id="inCantidad"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Detalle_Factura!.Cantidad" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Costo Unitario
                        </label>
                        <div class="col-6">
                            <input id="inCosto_Unitario"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Detalle_Factura!.Costo_Unitario" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Descuento Aplicado
                        </label>
                        <div class="col-6">
                            <input id="inDescuento_Aplicado"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Detalle_Factura!.Descuento_Aplicado" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Subtotal
                        </label>
                        <div class="col-6">
                            <input id="inSubtotal"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Detalle_Factura!.Subtotal" />
                        </div>
                    </div>
                    <div style="margin-top: 20px;">
                        <select id="nmFactura"
                                class="form-control"
                                asp-for="@Model.Detalle_Factura!.Factura"
                                asp-items="@(new SelectList(Model.CargarFacturas(), "Id_Factura", "Numero"))">
                            <option value="">-- Seleccione una factura --</option>
                        </select>

                    </div>
                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Detalle_Factura != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Detalle_Factura?
                            </h6>
                            <h6 align="left">
                                @Model.Detalle_Factura!.Cantidad
                            </h6>

                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }
            @if (Model != null && Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Cantidad
                        </th>
                        <th>
                            Costo_Unitario
                        </th>
                        <th class="cl_hidden">
                            Descuento_Aplicado
                        </th>
                        <th class="cl_hidden">
                            Subtotal
                        </th>
                        <th class="cl_hidden">
                            Factura
                        </th>
                        <th class="cl_actions">
                            Acción
                        </th>
                    </tr>

                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>
                                @elemento.Cantidad
                            </td>
                            <td>
                                @elemento.Costo_Unitario
                            </td>
                            <td class="cl_hidden">
                                @elemento.Descuento_Aplicado
                            </td>
                            <td class="cl_hidden">
                                @elemento.Subtotal
                            </td>
                            <td class="cl_hidden">
                                @elemento.Factura
                            </td>
                            <td>
                                <input type="submit"
                                       value="Modicar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id_Detalle" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id_Detalle" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>