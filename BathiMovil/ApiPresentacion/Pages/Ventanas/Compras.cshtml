@page
@model ComprasModel
@{
    ViewData["Title"] = "Compras";
}
<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Cantidad" />
            <input type="hidden" asp-for="TPortatil" />
            <input type="hidden" asp-for="Compra" />
            <div align="left">
                <h3>Compras</h3>
            </div>
            
            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" 
                       disabled ="@(Model.VienePorCompra)"/>
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-success"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Compra != null || Model.VienePorCompra)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Compra == null || Model.VienePorCompra)" />
                <button asp-page-handler="ExportarPdf"
                        class="btn btn-danger">
                    Exportar PDF
                </button>
            </div>

            @if (Model.Compra != null)
            {
                <input type="hidden"
                       asp-for="@Model.Compra!.Id_Compra" />

                <div>
                    <div style="margin-top: 20px;">
                        <label>
                            Metodo de Pago
                        </label>
                        <div class="col-6">
                            <input id="inMetodo_Pago"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Compra!.Metodo_Pago"
                                    />
                        </div>
                    </div>
                    <div style="margin-top: 20px;">
                        <label>
                            Monto Total
                        </label>
                        <div class="col-6">
                            <input id="inMonto_Total"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Compra!.Monto_Total"
                                   readonly="@Model.VienePorCompra" />
                        </div>
                    </div>
                    <div style="margin-top: 20px;">
                        <label>
                          Mese de garantia 
                        </label>
                        <div class="col-6">
                            <input id="inGarantia_Meses"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Compra!.Garantia_Meses"
                                   readonly="@Model.VienePorCompra" />
                        </div>
                    </div>
                    <div style="margin-top: 20px;">
                        <label>
                            Fecha_Compra
                        </label>
                        <div class="col-6">
                            <input id="inFecha_Compra"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Compra!.Fecha_Compra"
                                   readonly="@Model.VienePorCompra" />
                        </div>
                    </div>
                    <div style="margin-top: 20px;">
                        <select id="nmRoles"
                                class="form-control"
                                asp-for="@Model.Compra!.Contrato"
                                asp-items="@(new SelectList(Model.CargarContratos(), "Id_Contrato", "Fecha_Firma"))"
                                readonly="@Model.VienePorCompra">
                            <option value="">-- Seleccione un contrato --</option>
                             
                        </select>
                    </div>
                        @if (Model.VienePorCompra)
                        {
                        <input type="hidden" asp-for="ConfirmarCompra" />
                        <input type="submit"
                               value="Comprar"
                               asp-page-handler="BtComprar"
                               class="btn btn-success" />
                        }
                </div>
            }

             @if(Model.ConfirmarCompra)
            {
                
                <div class='popup' style="margin-top: 55px;">
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>

                            <h6 align="left">
                                COMPRA EFECTUADA, EL ENVIO ESTA POR PROGRAMARSE
                            </h6>
                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtTerminar"
                                   class="btn btn-secondary" 
                                   style="margin-top: 55px;" />
                    </div>
                </div>
                </div>
            }
            
            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Compra != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Compra?
                            </h6>
                            <h6 align="left">
                                @Model.Compra!.Metodo_Pago
                            </h6>
                            
                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }
            @if (Model != null && Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Metodo de Pago
                        </th>
                        <th>
                            Monto Total
                        </th>
                        <th>
                            Fecha de compra
                        </th>
                        <th>
                            Garantia de meses
                        </th>
                        <th class="cl_hidden">
                            Contrato
                        </th>
                    </tr>
                
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td class="cl_hidden">
                                @elemento.Metodo_Pago
                            </td>
                            <td>
                                @elemento.Monto_Total
                            </td>
                            <td>
                                @elemento.Fecha_Compra
                            </td>
                            <td>
                                @elemento.Garantia_Meses
                            </td>
                            <td class="cl_hidden">
                                @elemento.Contrato
                            </td>
                            <td>
                                <input type="submit"
                                       value="Modicar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id_Compra" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id_Compra" />
                            </td>
                        </tr>
                    }
                </table>
            }

          @if (Model!.MostrarConfirmacionSalida)
{
    <div class='popup'>
        <div class='pp_ms_inner'>
            <div style='width:95%'>
                <h6 align="left">
                    ¿Seguro que deseas salir? Perderás tu compra.
                </h6>
                <input type="submit"
                       value="Quedarse"
                       asp-page-handler="BtCerrar"
                       class="btn btn-success" />
                <input type="submit"
                       value="Salir de todas formas"
                       asp-page-handler="BtRefrescarConfirmado"
                       class="btn btn-secondary" />
            </div>
        </div>
    </div>
}
            
        </form>
       
    </div>
</center>

