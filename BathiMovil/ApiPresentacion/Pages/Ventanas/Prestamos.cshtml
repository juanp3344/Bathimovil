@page
@model PrestamosModel
@{
    ViewData["Title"] = "Prestamos";
}
<center>
    <div>
        <form method="POST" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Cantidad" />
            <input type="hidden" asp-for="TPortatil" />
            <input type="hidden" asp-for="Prestamo" />
            
            <div align="left">
                <h3>Prestamos de Portátiles</h3>
            </div>
            
            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar"
                       disabled="@(Model.VienePorPrestamo)" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-success"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Prestamo != null || Model.VienePorPrestamo)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Prestamo == null || Model.VienePorPrestamo)" />
            </div>

            @if (Model.Prestamo != null)
            {
                <input type="hidden" asp-for="@Model.Prestamo!.Id_Prestamo" />

                <div>
                    <div style="margin-top: 20px;">
                        <label>Fecha de Inicio</label>
                        <div class="col-6">
                            <input id="inFecha_Inicio"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Prestamo!.Fecha_Inicio" />
                        </div>
                    </div>
                    <div style="margin-top: 20px;">
                        <label>Fecha de Fin Prevista</label>
                        <div class="col-6">
                            <input id="inFecha_Fin_Prevista"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Prestamo!.Fecha_Fin_Prevista"
                                   readonly="@Model.VienePorPrestamo" />
                        </div>
                    </div>
                    <div style="margin-top: 20px;">
                        <label>Estado del Préstamo (Activo)</label>
                        <div class="col-6">
                            <input type="checkbox"
                                   asp-for="@Model.Prestamo!.Estado_Prestamo"
                                   disabled="@Model.VienePorPrestamo" />
                        </div>
                    </div>
                    <div style="margin-top: 20px;">
                        <select id="nmContratos"
                                class="form-control"
                                asp-for="@Model.Prestamo!.Contrato"
                                asp-items="@(new SelectList(Model.CargarContratos(), "Id_Contrato", "Fecha_Firma"))"
                                readonly="@Model.VienePorPrestamo">
                            <option value="">-- Seleccione un contrato --</option>
                        </select>
                    </div>
                    
                    @if (Model.VienePorPrestamo)
                    {
                        <input type="hidden" asp-for="ConfirmarPrestamo" />
                        <input type="submit"
                               value="Confirmar Préstamo"
                               asp-page-handler="BtPrestar"
                               class="btn btn-success" />
                    }
                </div>
            }

            @if (Model.ConfirmarPrestamo)
            {
                <div class='popup' style="margin-top: 55px;">
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h6 align="left">
                                PRÉSTAMO PROCESADO CORRECTAMENTE Y EQUIPO ASIGNADO
                            </h6>
                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtTerminar"
                                   class="btn btn-secondary"
                                   style="margin-top: 55px;" />
                        </div>
                    </div>
                </div>
            }
            
            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
            }

            @if (Model.Prestamo != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">Mensaje</h2>
                            <h6 align="left">¿Desea borrar el Registro de Préstamo?</h6>
                            
                            <input type="submit" value="Cerrar" asp-page-handler="BtCerrar" class="btn btn-secondary" />
                            <input type="submit" value="Borrar" asp-page-handler="BtBorrar" class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model != null && Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Fecha Inicio</th>
                        <th>Fecha Fin Prevista</th>
                        <th>Estado</th>
                        <th>Contrato</th>
                        <th>Acciones</th>
                    </tr>
                
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>@elemento.Fecha_Inicio</td>
                            <td>@elemento.Fecha_Fin_Prevista</td>
                            <td>@elemento.Estado_Prestamo</td>
                            <td>@elemento.Contrato</td>
                            <td>
                                <input type="submit"
                                       value="Modificar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id_Prestamo" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id_Prestamo" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>