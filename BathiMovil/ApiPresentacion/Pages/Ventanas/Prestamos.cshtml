@page
@model PrestamosModel
@{
    ViewData["Title"] = "Prestamos";
}
<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Prestamos</h3>
            </div>

            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Prestamo != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Prestamo == null)" />
            </div>

            @if (Model.Prestamo != null)
            {
                <input type="hidden"
                       asp-for="@Model.Prestamo!.Id_Prestamo" />

                <div>
                    <div class="form-group">
                        <label>
                            Fecha_Inicio
                        </label>
                        <div class="col-6">
                            <input id="inFecha_Inicio"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Prestamo!.Fecha_Inicio" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Fecha_Fin_Prevista
                        </label>
                        <div class="col-6">
                            <input id="inFecha_Fin_Prevista"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Prestamo!.Fecha_Fin_Prevista" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Estado_Prestamo
                        </label>
                        <div class="col-6">
                            <input id="inEstado_Prestamo"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Prestamo!.Estado_Prestamo" />
                        </div>
                    </div>
                    <div style="margin-top: 20px;">
                        <select id="nmContrato"
                                class="form-control"
                                asp-for="@Model.Prestamo!.Contrato"
                                asp-items="@(new SelectList(Model.CargarContratos(), "Id_Contrato", "Id_Contrato"))">
                            <option value="">-- Seleccione un Contrato --</option>
                        </select>
                    </div>

                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Prestamo != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Prestamo?
                            </h6>
                            <h6 align="left">
                                @Model.Prestamo!.Fecha_Inicio
                            </h6>

                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-danger" />
                        </div>
                    </div>
                </div>
            }
            @if (Model != null && Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Fecha_Inicio
                        </th>
                        <th>
                            Fecha_Fin_Prevista
                        </th>
                        <th class="cl_hidden">
                            Estado_Prestamo
                        </th>
                        <th class="cl_hidden">
                            Contrato
                        </th>
                    </tr>

                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>
                                @elemento.Fecha_Inicio
                            </td>
                            <td>
                                @elemento.Fecha_Fin_Prevista
                            </td>
                            <td class="cl_hidden">
                                @elemento.Estado_Prestamo
                            </td>
                            <td>
                                @elemento.Contrato
                            </td>
                            <td>
                                <input type="submit"
                                       value="Modicar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-warning"
                                       asp-route-data="@elemento.Id_Prestamo" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-danger"
                                       asp-route-data="@elemento.Id_Prestamo" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>