@page
@model ImplementosModel
@{
    ViewData["Title"] = "Implementos";
}
<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Implementos</h3>
            </div>

            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Implemento != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Implemento == null)" />
            </div>

            @if (Model.Implemento != null)
            {
                <input type="hidden"
                       asp-for="@Model.Implemento!.Id_Implemento" />

                <div>
                    <div class="form-group">
                        <label>
                            Vida_Util
                        </label>
                        <div class="col-6">
                            <input id="inVida_Util"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Implemento!.Vida_Util" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Estado
                        </label>
                        <div class="col-6">
                            <input id="inEstado"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Implemento!.Estado" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            fecha_fabricacion
                        </label>
                        <div class="col-6">
                            <input id="infecha_fabricacion"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Implemento!.fecha_fabricacion" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Marca
                        </label>
                        <div class="col-6">
                            <input id="inMarca"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Implemento!.Marca" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Costo
                        </label>
                        <div class="col-6">
                            <input id="inCosto"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Implemento!.Costo" />
                        </div>

                    </div>
                    <div style="margin-top: 20px;">
                        <select id="nmPortatil"
                                class="form-control"
                                asp-for="@Model.Implemento!.Portatil"
                                asp-items="@(new SelectList(Model.CargarPortatiles(), "Id_Portatil", "Numero_Serial"))">
                            <option value="">-- Seleccione un baño portatil --</option>
                        </select>
                    </div>

                   

                    <div style="margin-top: 20px;">
                        <select id="nmBodega"
                                class="form-control"
                                asp-for="@Model.Implemento!.Bodega"
                                asp-items="@(new SelectList(Model.CargarBodegas(), "Id_Bodega", "Nombre"))">
                            <option value="">-- Seleccione una bodega --</option>
                        </select>
                    </div>

                    <div style="margin-top: 20px;">
                        <select id="nmTipo"
                                class="form-control"
                                asp-for="@Model.Implemento!.Tipo_Implemento"
                                asp-items="@(new SelectList(Model.CargarTipos(), "Id_Tipo_Implemento", "Nombre"))">
                            <option value="">-- Seleccione un tipo de implemento--</option>
                        </select>
                    </div>

                </div>
            }

            @if (Model.ErrorRol)
            {
                <div class="popup">
                    <div class="popup-dialog">
                        <div class="popup-body">
                            <div class="popup-icon">⚠️</div>
                            <div>
                                <p class="popup-title">Rol no permitido</p>
                                <p class="popup-message">
                                    El rol que tienes <strong>NO</strong> es valido para esta opción.
                                </p>
                            </div>
                        </div>
                        <div class="popup-footer">
                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtVolver"
                                   class="btn btn-danger" />
                        </div>
                    </div>
                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Implemento != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Implemento?
                            </h6>
                            <h6 align="left">
                                @Model.Implemento!.Vida_Util
                            </h6>

                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-danger" />
                        </div>
                    </div>
                </div>
            }
            @if (Model != null && Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Vida_Util
                        </th>
                        <th>
                            Estado
                        </th>
                        <th class="cl_hidden">
                            fecha_fabricacion
                        </th>
                        <th class="cl_hidden">
                            Marca
                        </th>
                        <th class="cl_hidden">
                            Costo
                        </th>
                        <th class="cl_hidden">
                            Portatil
                        </th>
                        <th class="cl_hidden">
                            Bodega
                        </th>
                        <th class="cl_hidden">
                            Tipo Implemento
                        </th>
                    </tr>

                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>
                                @elemento.Vida_Util
                            </td>
                            <td>
                                @elemento.Estado
                            </td>
                            <td class="cl_hidden">
                                @elemento.fecha_fabricacion
                            </td>
                            <td>
                                @elemento.Marca
                            </td>
                            <td class="cl_hidden">
                                @elemento.Costo
                            </td>
                            <td class="cl_hidden">
                                @elemento.Portatil
                            </td>
                            <td class="cl_hidden">
                                @elemento.Bodega
                            </td>
                            <td class="cl_hidden">
                                @elemento.Tipo_Implemento
                            </td>
                            <td>
                                <input type="submit"
                                       value="Modicar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-warning"
                                       asp-route-data="@elemento.Id_Implemento" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-danger"
                                       asp-route-data="@elemento.Id_Implemento" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>