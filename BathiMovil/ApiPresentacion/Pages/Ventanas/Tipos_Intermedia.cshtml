@page
@model Tipos_IntermediaModel
@{
    ViewData["Title"] = "Tipos Intermedia";
}
<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Tipos Intermedia</h3>
            </div>

            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Tipos_Intermedia != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Tipos_Intermedia == null)" />
            </div>

            @if (Model.Tipos_Intermedia != null)
            {
                <input type="hidden"
                       asp-for="@Model.Tipos_Intermedia!.Id_Tipos_Intermedia" />

                <div>
                    <div class="form-group">
                        <label>
                            Posicion_Montaje
                        </label>
                        <div class="col-6">
                            <input id="inPosicion_Montaje"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Tipos_Intermedia!.Posicion_Montaje" />
                        </div>
                    </div>
                    <div style="margin-top: 20px;">
                        <select id="nmTipo"
                                class="form-control"
                                asp-for="@Model.Tipos_Intermedia!.Tipo_Implemento"
                                asp-items="@(new SelectList(Model.CargarTipos(), "Id_Tipo_Implemento", "Nombre"))">
                            <option value="">-- Seleccione un tipo de implemento--</option>
                        </select>
                    </div>
                    <div style="margin-top: 20px;">
                        <select id="nmTipoPorta"
                                class="form-control"
                                asp-for="@Model.Tipos_Intermedia!.Tipo_Portatil"
                                asp-items="@(new SelectList(Model.CargarTipoPorta(), "Id_Tipo_Portatil", "Nombre"))">
                            <option value="">-- Seleccione un tipo de portatil--</option>
                        </select>
                    </div>

                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Tipos_Intermedia != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Tipos_Intermedia?
                            </h6>
                            <h6 align="left">
                                @Model.Tipos_Intermedia!.Posicion_Montaje
                            </h6>

                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-danger" />
                        </div>
                    </div>
                </div>
            }
            @if (Model != null && Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Posicion_Montaje
                        </th>
                        <th>
                            Tipo_Implemento
                        </th>
                        <th class="cl_hidden">
                            Tipo_Portatil
                        </th>
                    </tr>

                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>
                                @elemento.Posicion_Montaje
                            </td>
                            <td>
                                @elemento.Tipo_Implemento
                            </td>
                            <td class="cl_hidden">
                                @elemento.Tipo_Portatil
                            </td>
                            <td>
                                <input type="submit"
                                       value="Modicar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-warning"
                                       asp-route-data="@elemento.Id_Tipos_Intermedia" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-danger"
                                       asp-route-data="@elemento.Id_Tipos_Intermedia" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>