@page
@model RolesModel
@{
    ViewData["Title"] = "Roles";
}
<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Roles</h3>
            </div>
            
            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Rol != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Rol == null)" />
            </div>

            @if (Model.Rol != null)
            {
                <input type="hidden"
                       asp-for="@Model.Rol!.Id_Rol" />

                <div>
                    <div class="form-group">
                        <label>
                            Nombre_Rol
                        </label>
                        <div class="col-6">
                            <input id="inNombre_Rol"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Rol!.Nombre_Rol" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Descripcion_Rol
                        </label>
                        <div class="col-6">
                            <input id="inDescripcion_Rol"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Rol!.Descripcion_Rol" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Salario_Empleado
                        </label>
                        <div class="col-6">
                            <input id="inSalario_Empleado"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Rol!.Salario_Empleado" />
                        </div>
                    </div>
                </div>
            }
            
            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Rol != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Rol?
                            </h6>
                            <h6 align="left">
                                @Model.Rol!.Nombre_Rol
                            </h6>
                            
                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-danger" />
                        </div>
                    </div>
                </div>
            }
            @if (Model != null && Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Nombre_Rol
                        </th>
                        <th>
                            Descripcion_Rol
                        </th>
                        <th class="cl_hidden">
                            Salario_Empleado
                        </th>
                    </tr>
                
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>
                                @elemento.Nombre_Rol
                            </td>
                            <td>
                                @elemento.Descripcion_Rol
                            </td>
                            <td class="cl_hidden">
                                @elemento.Salario_Empleado
                            </td>
                            <td>
                                <input type="submit"
                                       value="Modicar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-warning"
                                       asp-route-data="@elemento.Id_Rol" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-danger"
                                       asp-route-data="@elemento.Id_Rol" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>